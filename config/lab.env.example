# =============================================================================
# config/lab.env.example
#
# Template for config/lab.env — populated automatically by scripts/deploy
# from Bicep outputs.  Copy this file to config/lab.env and fill in values,
# OR let scripts/deploy generate config/lab.env for you.
#
# config/lab.env is gitignored.  This example file IS committed.
# All variable names use UPPER_SNAKE_CASE.
# =============================================================================

# --- Lab-wide settings -------------------------------------------------------
LAB_LOCATION=southcentralus
LAB_RESOURCE_GROUP=
LAB_SUBSCRIPTION_ID=

# --- Log Analytics Workspace -------------------------------------------------
LAW_NAME=
# Full ARM resource ID of the workspace
# /subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.OperationalInsights/workspaces/<name>
LAW_ID=

# --- Data Collection Endpoint ------------------------------------------------
# Logs Ingestion endpoint URL (https://<dce-id>.<region>.ingest.monitor.azure.com)
DCE_LOGS_INGESTION_ENDPOINT=

# =============================================================================
# Per-scenario bindings (one block per scenario)
# DCR_IMMUTABLE_ID_<SCENARIO>  — immutableId from the deployed DCR resource
# STREAM_<SCENARIO>            — stream name used in the ingestion call
# TABLE_<SCENARIO>             — destination custom table in the workspace
# =============================================================================

# --- Virtual Machines --------------------------------------------------------
DCR_IMMUTABLE_ID_VIRTUAL_MACHINES=
STREAM_VIRTUAL_MACHINES=Custom-VirtualMachines_CL
TABLE_VIRTUAL_MACHINES=VirtualMachines_CL

# --- App Service -------------------------------------------------------------
DCR_IMMUTABLE_ID_APP_SERVICE=
STREAM_APP_SERVICE=Custom-AppService_CL
TABLE_APP_SERVICE=AppService_CL

# --- AKS ---------------------------------------------------------------------
DCR_IMMUTABLE_ID_AKS=
STREAM_AKS=Custom-AKS_CL
TABLE_AKS=AKS_CL

# --- Azure SQL ---------------------------------------------------------------
DCR_IMMUTABLE_ID_AZURE_SQL=
STREAM_AZURE_SQL=Custom-AzureSQL_CL
TABLE_AZURE_SQL=AzureSQL_CL

# --- APM (Applications) ------------------------------------------------------
DCR_IMMUTABLE_ID_APM=
STREAM_APM=Custom-APM_CL
TABLE_APM=APM_CL
