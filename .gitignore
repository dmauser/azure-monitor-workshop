# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/
.env/
pip-wheel-metadata/

# =============================================================================
# Azure / lab config (generated at deploy-time — never commit secrets)
# =============================================================================
config/lab.env
# demo-vm secrets and SSH keys — NEVER commit
config/vm.env
config/keys/
*.pem
id_rsa*
id_ed25519*
*.azcli
.azure/
# Bicep-compiled ARM templates (build artifacts — source of truth is .bicep)
infra/**/*.json

# =============================================================================
# Editor / OS junk
# =============================================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/settings.json
*.code-workspace

# =============================================================================
# Render / media artifacts
# =============================================================================
*.pdf
*.jpg
*.jpeg
*.png
*.gif

# Allow committed documentation screenshots for the workshop guides
!docs/images/
!docs/images/**

# =============================================================================
# Squad: ignore runtime state (logs, inbox, sessions)
# =============================================================================
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
