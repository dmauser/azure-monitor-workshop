# Squad: union merge for append-only team state files
.squad/decisions.md merge=union
.squad/agents/*/history.md merge=union
.squad/log/** merge=union
.squad/orchestration-log/** merge=union

# Line endings: normalize in the repo, force LF for shell scripts so they run on
# Linux/macOS; keep CRLF for PowerShell/Windows batch.
* text=auto
*.sh   text eol=lf
*.bash text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
