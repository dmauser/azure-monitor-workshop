// ============================================================
// Scenario  : AKS / Containers
// Table     : AKS_CL
// Deck refs : Watch → node/pod CPU/mem, restarts, crashloop, node NotReady,
//                     PV usage, control-plane
//             Alerts → CrashLoopBackOff, node NotReady, PVC full, HPA maxed,
//                      API-server errors
// ============================================================
// Column contract (schema source of truth for DCR + generator):
//   TimeGenerated       datetime  — Log Analytics injection timestamp
//   Resource            string    — cluster name (e.g. "aks-prod-01")
//   ResourceId          string    — full ARM resource ID
//   Environment         string    — prod | staging | dev
//   Region              string    — Azure region
//   Namespace           string    — Kubernetes namespace
//   NodeName            string    — node hostname
//   PodName             string    — pod name (may be empty for node-level rows)
//   ContainerName       string    — container name (may be empty for pod/node rows)
//   NodeCpuPercent      real      — node CPU utilisation 0–100
//   NodeMemoryPercent   real      — node memory utilisation 0–100
//   PodCpuPercent       real      — pod CPU utilisation 0–100
//   PodMemoryPercent    real      — pod memory utilisation 0–100
//   PodRestartCount     int       — cumulative restart count for the pod
//   PodPhase            string    — Running | Pending | Failed | Succeeded | Unknown
//   PodReason           string    — detailed status reason (e.g. "CrashLoopBackOff")
//   NodeStatus          string    — Ready | NotReady | Unknown
//   PVName              string    — PersistentVolume name (empty if no PV)
//   PVUsagePercent      real      — PV disk usage 0–100 (0 if no PV)
//   HpaName             string    — HPA name if applicable
//   HpaCurrentReplicas  int       — current replica count
//   HpaMaxReplicas      int       — configured max replicas
// ============================================================


// ── [1] Workbook: Node CPU & Memory utilisation ───────────────
// Workbook: heatmap or line chart per node; NodeCpuPercent + NodeMemoryPercent.
let _timeRange = 1h;
let _binSize   = 5m;
AKS_CL
| where TimeGenerated >= ago(_timeRange)
| where isnotempty(NodeName)
| summarize
    AvgNodeCpu    = avg(NodeCpuPercent),
    MaxNodeCpu    = max(NodeCpuPercent),
    AvgNodeMemPct = avg(NodeMemoryPercent)
    by bin(TimeGenerated, _binSize), Resource, NodeName, Environment
| order by TimeGenerated asc


// ── [2] Workbook: Pod CPU & Memory utilisation ────────────────
// Workbook: top-N pods by CPU; useful for noisy-neighbour detection.
let _timeRange = 1h;
let _binSize   = 5m;
AKS_CL
| where TimeGenerated >= ago(_timeRange)
| where isnotempty(PodName)
| summarize
    AvgPodCpu    = avg(PodCpuPercent),
    AvgPodMemPct = avg(PodMemoryPercent)
    by bin(TimeGenerated, _binSize), Resource, Namespace, PodName, Environment
| top-nested 1 of TimeGenerated by any(TimeGenerated),
  top-nested 20 of PodName by AvgPodCpu
| order by AvgPodCpu desc


// ── [3] Workbook: Pod restarts over time ─────────────────────
// Workbook: stacked bar; rising restart count signals instability.
let _timeRange = 1h;
let _binSize   = 5m;
AKS_CL
| where TimeGenerated >= ago(_timeRange)
| where isnotempty(PodName)
| summarize MaxRestarts = max(PodRestartCount)
    by bin(TimeGenerated, _binSize), Resource, Namespace, PodName, Environment
| order by MaxRestarts desc


// ── [4] Workbook: CrashLoopBackOff detection ─────────────────
// Workbook: shows all pods currently in or recently in CrashLoopBackOff.
let _timeRange = 1h;
AKS_CL
| where TimeGenerated >= ago(_timeRange)
| where PodReason == "CrashLoopBackOff" or PodPhase == "Failed"
| summarize
    FirstSeen     = min(TimeGenerated),
    LastSeen      = max(TimeGenerated),
    MaxRestarts   = max(PodRestartCount),
    Occurrences   = count()
    by Resource, Namespace, PodName, PodReason, Environment
| order by MaxRestarts desc


// ── [5] Workbook: Node NotReady status ───────────────────────
// Workbook: timeline of node availability; NotReady rows appear as gaps.
let _timeRange = 1h;
AKS_CL
| where TimeGenerated >= ago(_timeRange)
| where isnotempty(NodeName)
| summarize
    LatestStatus = arg_max(TimeGenerated, NodeStatus)
    by Resource, NodeName, Environment
| extend IsNotReady = NodeStatus != "Ready"
| project Resource, NodeName, Environment, NodeStatus, IsNotReady, LastReported = TimeGenerated
| order by IsNotReady desc


// ── [6] Workbook: PersistentVolume usage ─────────────────────
// Workbook: PV utilisation per pod/namespace; > 80% is a near-full warning.
let _timeRange = 1h;
AKS_CL
| where TimeGenerated >= ago(_timeRange)
| where isnotempty(PVName)
| summarize AvgPVUsage = avg(PVUsagePercent), MaxPVUsage = max(PVUsagePercent)
    by bin(TimeGenerated, 5m), Resource, Namespace, PodName, PVName, Environment
| extend Severity = case(
    MaxPVUsage >= 90.0, "Critical",
    MaxPVUsage >= 80.0, "Warning",
    "OK")
| order by MaxPVUsage desc


// ── [7] Alert: CrashLoopBackOff — any pod in last 5 min ──────
// Alert: fires when any pod reports CrashLoopBackOff in the last 5-min window.
// Scheduled-query rule: frequency = 5m, lookback = 5m, row count > 0.
AKS_CL
| where TimeGenerated >= ago(5m)
| where PodReason == "CrashLoopBackOff"
| summarize
    CrashCount  = count(),
    MaxRestarts = max(PodRestartCount)
    by bin(TimeGenerated, 5m), Resource, Namespace, PodName, Environment
| project TimeGenerated, Resource, Namespace, PodName, Environment, CrashCount, MaxRestarts


// ── [8] Alert: Node NotReady detected ────────────────────────
// Alert: fires when any node enters NotReady state in the last 5-min window.
// Scheduled-query rule: frequency = 5m, lookback = 5m, row count > 0.
AKS_CL
| where TimeGenerated >= ago(5m)
| where NodeStatus == "NotReady"
| summarize NotReadyCount = count()
    by bin(TimeGenerated, 5m), Resource, NodeName, Environment
| project TimeGenerated, Resource, NodeName, Environment, NotReadyCount
